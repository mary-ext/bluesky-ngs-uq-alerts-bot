{
	"$schema": "https://unpkg.com/oxfmt/configuration_schema.json",
	"trailingComma": "all",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 110,
	"semi": true,
	"singleQuote": true,
	"bracketSpacing": true,
	"jsdoc": {
		"capitalizeDescriptions": false
	},
	"sortImports": {
		"groups": [["builtin", "cloudflare"], ["external"], ["parent"], ["sibling", "index"]],
		"customGroups": [
			{
				"groupName": "cloudflare",
				"elementNamePattern": ["cloudflare:*"]
			}
		]
	},
	"overrides": [
		{
			"files": ["tsconfig.json", "wrangler.jsonc"],
			"options": { "parser": "jsonc" }
		},
		{
			"files": ["*.md"],
			"options": { "printWidth": 100, "proseWrap": "always" }
		}
	]
}
