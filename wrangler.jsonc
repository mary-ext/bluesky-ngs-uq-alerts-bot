/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bluesky-ngs-uq-alerts-bot-cf",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-21",
	"observability": {
		"enabled": true,
	},
	"triggers": {
		"crons": ["16,18,20,22,25,46,48,50,52,55 * * * *"],
	},
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "7f3c5e2290a74284839593d19512453a",
		},
	],
	"vars": {
		"BLUESKY_JP_PDS": "",
		"BLUESKY_JP_IDENTIFIER": "",
		"BLUESKY_JP_PASSWORD": "",
		"BLUESKY_GL_PDS": "",
		"BLUESKY_GL_IDENTIFIER": "",
		"BLUESKY_GL_PASSWORD": "",
	},
}
